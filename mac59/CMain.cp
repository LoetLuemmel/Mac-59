/******************************************************************************
 CMain.c

				CMain Document Class

	Generated by Visual Architect - extended by Pit Förster with Claude Code via AppleBridge
	(2026-10-26): "Rechner 2", the TI-59 from its ROM.

	Rechner's TI-59 case and keys around the TMC0501 emulator of Calc-U-59
	(TI59Core.cp, GPL-3.0, (c) 2026 Martin Erzberger). Nothing is computed
	here: a key presses the emulated keyboard matrix (row*10 + col), the ROM
	does the rest, and the display shows what the ROM multiplexes onto the
	twelve LEDs, drawn as seven-segment cells. The PC-100C printer gets a
	window of its own next to the calculator.

	Timing: an idle chore runs the CPU at the TI-59's clock (455 kHz / 32 =
	14 219 instructions per second, an IDLE instruction counts four), or as
	fast as the Mac can if "Volle Geschwindigkeit" is on. A key is held for
	0.1 s of TI time and released; the next waits until the keyboard loop
	runs again (or 0.4 s, so R/S still reaches a running program).

	The ROM (Texas Instruments' firmware, private use) is resource 'TROM' 128
	in Project Resources.rsrc: 6144 words big-endian + 1024 constant nibbles.

	Layout: window 296 x 548 - case 0,0; display 12,26 272 x 38; keys 14,118
	in 5 columns x 9 rows, pitch 56 x 44. Printer window 208 x 548 beside it.

	The source is plain ASCII; characters outside it are MacRoman escapes.

 ******************************************************************************/

#include "CMain.h"
#include "AppCommands.h"
#include "TI59Core.h"			/* TI59Core.cp is a project file of its own, in its own segment:	*/
#include "CardText.cp"			/* with it CMain.cp came to the 32 KB of one 68K code segment	*/
#include "ListStop.h"
#include "RomText.h"

#include <CApplication.h>
#include <CBartender.h>
#include <CEditText.h>
#include <CScrollPane.h>
#include <CStyleText.h>
#include <Commands.h>
#include <CWindow.h>

#include <Balloons.h>
#include <Dialogs.h>
#include <Errors.h>
#include <Files.h>
#include <StandardFile.h>
#include <Resources.h>
#include <Scrap.h>
#include <TextEdit.h>

extern	CApplication	*gApplication;
extern	CBartender		*gBartender;

#define kMonaco			4
#define kGeneva			3
#define kSettingsDLOG	201
#define kWinWidth		296
#define kWinHeight		548
#define kPrnWidth		208
#define kKeyHelpID		133		/* 'hrct' of the 45 keys' balloons; 134 the same keys after 2nd */
#define kKey2ndHelpID	134
#define kPrinterHelpID	131		/* 'hrct' of the printer window's balloons (Ballonhilfe.r) */
#define kTickCycles		237L		/* 14218.75 instructions / 60 ticks		*/
#define kHoldCycles		1422L		/* a key press: 0.1 s of TI time		*/
#define kBusyHoldCycles	8532L		/* ... 0.6 s while the TI is busy	*/
#define kGapCycles		1422L		/* at least this long released			*/
#define kMaxGapCycles	5688L		/* ... and at most this long			*/

	// The 45 keys, row by row, with their 2nd labels - from the photograph.
	// The matrix code is (row + 1) * 10 + col + 1. Legend conventions for
	// CKeyPane: "x^2" draws a superscript, "*" a multiplication cross; the
	// 2nd label "xbar" draws x with a bar.
typedef struct {
	short		row, col;
	const char	*legend;
	const char	*second;
	short		style;
} KeyDef;

static const KeyDef kKeys[] = {
	{ 0, 0, "A",     "A'",     kKeyDark   }, { 0, 1, "B",     "B'",     kKeyDark   },
	{ 0, 2, "C",     "C'",     kKeyDark   }, { 0, 3, "D",     "D'",     kKeyDark   },
	{ 0, 4, "E",     "E'",     kKeyDark   },
	{ 1, 0, "2nd",   "",       kKeySecond }, { 1, 1, "INV",   "",       kKeyDark   },
	{ 1, 2, "lnx",   "log",    kKeyDark   }, { 1, 3, "CE",    "CP",     kKeyDark   },
	{ 1, 4, "CLR",   "",       kKeyOrange },
	{ 2, 0, "LRN",   "Pgm",    kKeyDark   }, { 2, 1, "x<>t",  "P->R",   kKeyDark   },
	{ 2, 2, "x^2",   "sin",    kKeyDark   }, { 2, 3, "\xC3x", "cos",    kKeyDark   },
	{ 2, 4, "1/x",   "tan",    kKeyDark   },
	{ 3, 0, "SST",   "Ins",    kKeyDark   }, { 3, 1, "STO",   "CMs",    kKeyDark   },
	{ 3, 2, "RCL",   "Exc",    kKeyDark   }, { 3, 3, "SUM",   "Prd",    kKeyDark   },
	{ 3, 4, "y^x",   "Ind",    kKeyDark   },
	{ 4, 0, "BST",   "Del",    kKeyDark   }, { 4, 1, "EE",    "Eng",    kKeyDark   },
	{ 4, 2, "(",     "Fix",    kKeyDark   }, { 4, 3, ")",     "Int",    kKeyDark   },
	{ 4, 4, "\xD6",  "|x|",    kKeyOrange },
	{ 5, 0, "GTO",   "Pause",  kKeyDark   }, { 5, 1, "7",     "x=t",    kKeyLight  },
	{ 5, 2, "8",     "Nop",    kKeyLight  }, { 5, 3, "9",     "Op",     kKeyLight  },
	{ 5, 4, "*",     "Deg",    kKeyOrange },
	{ 6, 0, "SBR",   "Lbl",    kKeyDark   }, { 6, 1, "4",     "x\xB3t", kKeyLight  },
	{ 6, 2, "5",     "\xB7+",  kKeyLight  }, { 6, 3, "6",     "xbar",   kKeyLight  },
	{ 6, 4, "-",     "Rad",    kKeyOrange },
	{ 7, 0, "RST",   "St flg", kKeyDark   }, { 7, 1, "1",     "If flg", kKeyLight  },
	{ 7, 2, "2",     "D.MS",   kKeyLight  }, { 7, 3, "3",     "\xB9",   kKeyLight  },
	{ 7, 4, "+",     "Grad",   kKeyOrange },
	{ 8, 0, "R/S",   "Write",  kKeyDark   }, { 8, 1, "0",     "Dsz",    kKeyLight  },
	{ 8, 2, ".",     "Adv",    kKeyLight  }, { 8, 3, "+/-",   "Prt",    kKeyLight  },
	{ 8, 4, "=",     "List",   kKeyOrange }
};
#define kKeyCount	(sizeof(kKeys) / sizeof(kKeys[0]))

	// Mac keyboard -> matrix code (0: not a calculator key).
static short KeyForChar(char c)
{
	switch (c) {
		case '0': return 92;	case '1': return 82;	case '2': return 83;	case '3': return 84;
		case '4': return 72;	case '5': return 73;	case '6': return 74;
		case '7': return 62;	case '8': return 63;	case '9': return 64;
		case '.': case ',': return 93;
		case '+': return 85;	case '-': return 75;	case '*': return 65;	case '/': return 55;
		case '=': case 0x0D: case 0x03: return 95;
		case '(': return 53;	case ')': return 54;	case '^': return 45;
		case 'e': return 52;						/* EE						*/
		case 0x1B: return 25;						/* Escape: CLR				*/
		case 0x08: return 24;						/* Delete: CE				*/
		case 'A': return 11;	case 'B': return 12;	case 'C': return 13;
		case 'D': return 14;	case 'E': return 15;
		case 'n': return 21;						/* 2nd						*/
		case 'i': return 22;						/* INV						*/
		case 'l': return 31;						/* LRN						*/
		case 'r': return 91;						/* R/S						*/
	}
	return 0;
}

	// The PC-100C's 64 characters in MacRoman (the printer's own glyphs where
	// MacRoman has them: \xC3 root, \xB9 pi, \xD6 division, \xB8 product, \xB7 sum).
static const char kPrnChars[65] =
	" 0123456789ABCDE-FGHIJKLMNOPQRST.UVWXYZ+x*\xC3\xB9" "e(),^%~/='xx2?\xD6!\"^\xB8\xB7";

	// Seven segments per glyph: bit 0 top, 1 upper right, 2 lower right,
	// 3 bottom, 4 lower left, 5 upper left, 6 middle (upstream SevenSegment.hpp).
static const unsigned char kDigitSeg[10] = {
	0x3F, 0x06, 0x5B, 0x4F, 0x66, 0x6D, 0x7D, 0x07, 0x7F, 0x6F
};
#define kSegMinus	0x40
#define kSegDegree	0x63
#define kSegC		0x39

	// Colours, matched to the photograph.
static const RGBColor kCase    = { 0x1600, 0x1400, 0x1200 };	/* body				*/
static const RGBColor kGlass   = { 0x2C00, 0x2600, 0x2200 };	/* display window	*/
static const RGBColor kLedBg   = { 0x1200, 0x0A00, 0x0800 };	/* behind the LEDs	*/
static const RGBColor kRed     = { 0xFFFF, 0x2000, 0x1800 };	/* LED				*/
static const RGBColor kCard    = { 0x1C00, 0x2A00, 0x4E00 };	/* card strip		*/
static const RGBColor kCardLn  = { 0x5800, 0x6800, 0xA000 };
static const RGBColor kCardTx  = { 0xB800, 0xC000, 0xD800 };
static const RGBColor kPanel   = { 0x1E00, 0x1C00, 0x1A00 };	/* key panel		*/
static const RGBColor kSilver  = { 0xA800, 0xA800, 0xA400 };	/* its frame		*/
static const RGBColor kLabel   = { 0xD800, 0xD800, 0xD000 };	/* 2nd labels		*/
static const RGBColor kDarkKey = { 0x2E00, 0x2A00, 0x2600 };
static const RGBColor kDarkTx  = { 0xE000, 0xDC00, 0xD400 };
static const RGBColor kLightKy = { 0xD800, 0xD400, 0xCA00 };
static const RGBColor kOrange  = { 0xF000, 0xA800, 0x3000 };
static const RGBColor kSecondK = { 0xC800, 0xC600, 0x8A00 };	/* 2nd: pale olive	*/
static const RGBColor kSecondOn = { 0xFFFF, 0xE800, 0x3000 };	/* 2nd waiting: lit yellow */
static const RGBColor kSecondT = { 0x3A00, 0x3600, 0x2000 };
static const RGBColor kHiLite  = { 0x6A00, 0x6600, 0x6000 };
static const RGBColor kShadow  = { 0x0800, 0x0600, 0x0400 };
static const RGBColor kPaper   = { 0xFFFF, 0xFFFF, 0xFFFF };	/* printer strip	*/
static const RGBColor kWhiteC  = { 0xFFFF, 0xFFFF, 0xFFFF };
static const RGBColor kBlackC  = { 0x0000, 0x0000, 0x0000 };


static void CToPStr(const char *c, Str255 p)
{
	short n = 0;
	while (c[n] != '\0' && n < 255) { p[n + 1] = (unsigned char) c[n]; n++; }
	p[0] = (unsigned char) n;
}

static short CLen(const char *c)
{
	short n = 0;
	while (c[n] != '\0') n++;
	return n;
}

static void CCat(char *dst, const char *src)
{
	short n = CLen(dst), i = 0;
	while (src[i] != '\0') dst[n++] = src[i++];
	dst[n] = '\0';
}

static void CCopy(char *dst, const char *src)
{
	dst[0] = '\0';
	CCat(dst, src);
}

static Boolean PEqual(Str255 p, const char *c)
{
	short i, n = CLen(c);
	if (p[0] != n) return FALSE;
	for (i = 0; i < n; i++) if (p[i + 1] != (unsigned char) c[i]) return FALSE;
	return TRUE;
}

static void LightenFor(short style, Boolean pressed, RGBColor *c)
{
	switch (style) {
		case kKeyLight:		*c = kLightKy; break;
		case kKeyOrange:	*c = kOrange;  break;
		case kKeySecond:	*c = kSecondK; break;
		default:			*c = kDarkKey; break;
	}
	if (pressed) {
		if (style == kKeyDark) { c->red += 0x3000; c->green += 0x3000; c->blue += 0x3000; }
		else { c->red -= 0x3000; c->green -= 0x3000; c->blue -= 0x3000; }
	}
}



/******************************************************************************
 CLedDisplay

	Twelve seven-segment cells, cell 11 leftmost. A cell is what the last
	display interval drove: its segments and its decimal point.

 ******************************************************************************/

CLedDisplay::CLedDisplay(CView *anEnclosure, CBureaucrat *aSupervisor,
						 short aWidth, short aHeight, short aHEncl, short aVEncl)
	: CPane(anEnclosure, aSupervisor, aWidth, aHeight, aHEncl, aVEncl,
			sizFIXEDLEFT, sizFIXEDTOP)
{
	short i;
	for (i = 0; i < 12; i++) { seg[i] = 0; dp[i] = 0; }
}


void CLedDisplay::SetCells(const unsigned char *aSeg, const unsigned char *aDp)
{
	short	i;
	Boolean	changed = FALSE;
	Rect	r;

	for (i = 0; i < 12; i++)
		if (seg[i] != aSeg[i] || dp[i] != aDp[i]) { seg[i] = aSeg[i]; dp[i] = aDp[i]; changed = TRUE; }
	if (changed) {
		Prepare();
		FrameToQDR(&frame, &r);
		Draw(&r);
	}
}


void CLedDisplay::GetText(char *out)
{
	short	i, d, n = 0;

	for (i = 11; i >= 0; i--) {
		if (seg[i] == kSegMinus) out[n++] = '-';
		else if (seg[i] == kSegDegree) out[n++] = 'o';
		else if (seg[i] == kSegC) out[n++] = 'C';
		else if (seg[i] != 0) {
			for (d = 0; d < 10 && kDigitSeg[d] != seg[i]; d++) ;
			out[n++] = (char) (d < 10 ? '0' + d : '?');
		}
		if (dp[i]) out[n++] = ',';
	}
	out[n] = '\0';
}


void CLedDisplay::Draw(Rect *area)
{
	Rect	r, s;
	short	i, x, y;
	unsigned char m;

	FrameToQDR(&frame, &r);
	RGBForeColor(&kLedBg);
	PaintRect(&r);
	RGBForeColor(&kRed);
	y = (short) (r.top + 8);
	for (i = 0; i < 12; i++) {
		x = (short) (r.right - 22 - 21 * i);			/* cell i, from the right	*/
		m = seg[i];
		if (m & 0x01) { SetRect(&s, x + 1, y,      x + 11, y + 2);  PaintRect(&s); }
		if (m & 0x02) { SetRect(&s, x + 10, y + 1, x + 12, y + 11); PaintRect(&s); }
		if (m & 0x04) { SetRect(&s, x + 10, y + 12, x + 12, y + 22); PaintRect(&s); }
		if (m & 0x08) { SetRect(&s, x + 1, y + 21, x + 11, y + 23); PaintRect(&s); }
		if (m & 0x10) { SetRect(&s, x,     y + 12, x + 2,  y + 22); PaintRect(&s); }
		if (m & 0x20) { SetRect(&s, x,     y + 1,  x + 2,  y + 11); PaintRect(&s); }
		if (m & 0x40) { SetRect(&s, x + 1, y + 10, x + 11, y + 12); PaintRect(&s); }
		if (dp[i])    { SetRect(&s, x + 14, y + 20, x + 17, y + 23); PaintRect(&s); }
	}
	RGBForeColor(&kBlackC);
	RGBBackColor(&kWhiteC);
}



/******************************************************************************
 CBodyPane

 ******************************************************************************/

CBodyPane::CBodyPane(CView *anEnclosure, CBureaucrat *aSupervisor, short aWidth, short aHeight)
	: CPane(anEnclosure, aSupervisor, aWidth, aHeight, 0, 0, sizFIXEDLEFT, sizFIXEDTOP)
{
	short i;

	info[0] = 0;
	cardName[0] = 0;
	for (i = 0; i < 5; i++) cue[i][0] = 0;
	SetWantsClicks(TRUE);
}


/* The cue card above A-E: what the module program's user keys do. */
void CBodyPane::SetCue(short i, const char *aLabel)
{
	Rect r;
	short n = 0;

	if (i < 0 || i > 4) return;
	while (aLabel[n] != '\0' && n < 31) { cue[i][n + 1] = (unsigned char) aLabel[n]; n++; }
	cue[i][0] = (unsigned char) n;
	Prepare();
	SetRect(&r, 6, 92, 290, 110);
	RefreshRect(&r);
}


/* The card's name in the strip, as the label on a card in the slot. */
void CBodyPane::SetCardName(Str255 aName)
{
	Rect r;

	BlockMove(aName, cardName, (long) aName[0] + 1);
	Prepare();
	SetRect(&r, 6, 74, 290, 92);
	RefreshRect(&r);
}


/* A click on the card strip reads a card. */
void CBodyPane::DoClick(Point hitPt, short modifierKeys, long when)
{
	if (hitPt.v >= 74 && hitPt.v < 110 && hitPt.h >= 6 && hitPt.h < 290 && itsSupervisor != NULL)
		itsSupervisor->DoCommand(cmdReadCard);
}


void CBodyPane::SetInfo(Str255 anInfo)
{
	Rect r;

	BlockMove(anInfo, info, (long) anInfo[0] + 1);
	Prepare();
	SetRect(&r, 10, 526, 170, 538);
	RefreshRect(&r);
}


void CBodyPane::Draw(Rect *area)
{
	Rect	r;
	short	x, w;

	FrameToQDR(&frame, &r);
	RGBForeColor(&kCase);
	PaintRect(&r);

	SetRect(&r, 6, 6, 290, 70);						/* the display window			*/
	RGBForeColor(&kGlass);
	PaintRect(&r);
	TextFont(kGeneva);								/* the maker's lettering		*/
	TextSize(10);
	TextFace(bold);
	TextMode(srcOr);
	RGBForeColor(&kLabel);
	MoveTo(16, 20);
	DrawString("\pM A C - 5 9");

	SetRect(&r, 6, 74, 290, 110);					/* the program-card strip		*/
	RGBForeColor(&kCard);
	PaintRect(&r);
	RGBForeColor(&kCardLn);
	MoveTo(6, 92);  LineTo(289, 92);
	MoveTo(6, 109); LineTo(289, 109);
	for (x = 62; x < 290; x += 56) { MoveTo(x, 92); LineTo(x, 109); }
	for (x = 0; x < 5; x++)							/* the cue card, one cell per key A-E	*/
		if (cue[x][0] > 0) {
			w = StringWidth(cue[x]);
			MoveTo((short) (38 + 56 * x - w / 2), 105);
			DrawString(cue[x]);
		}
	TextSize(9);
	RGBForeColor(&kCardTx);
	MoveTo(12, 87);
	if (cardName[0] > 0) DrawString(cardName);
	else DrawString("\pMAGNETKARTE");

	SetRect(&r, 6, 114, 290, 542);					/* the key panel				*/
	RGBForeColor(&kPanel);
	PaintRect(&r);
	InsetRect(&r, 3, 3);
	RGBForeColor(&kSilver);
	FrameRect(&r);

	TextFace(normal);								/* the model name, as printed	*/
	TextSize(12);									/* under the keys				*/
	RGBForeColor(&kLabel);
	w = StringWidth("\pProgrammable 59");
	MoveTo((short) (282 - w), 524);
	DrawString("\pProgrammable 59");
	TextSize(9);
	w = StringWidth("\pSolid State Software");
	MoveTo((short) (282 - w), 535);
	DrawString("\pSolid State Software");

	MoveTo(14, 535);								/* status: 2nd INV Deg Fix n	*/
	DrawString(info);

	RGBForeColor(&kBlackC);
	RGBBackColor(&kWhiteC);
}


/******************************************************************************
 CKeyPane

	The pane is 48 x 40: the 2nd label in the top 14 pixels, the key in the
	26 below. The key changes colour while pressed and sends its command
	when the mouse is released over it.

 ******************************************************************************/

CKeyPane::CKeyPane(CView *anEnclosure, CBureaucrat *aSupervisor,
				   short aWidth, short aHeight, short aHEncl, short aVEncl,
				   const char *aLegend, const char *aSecond, short aStyle, long aCommand)
	: CPane(anEnclosure, aSupervisor, aWidth, aHeight, aHEncl, aVEncl,
			sizFIXEDLEFT, sizFIXEDTOP)
{
	CToPStr(aLegend, legend);
	CToPStr(aSecond, second);
	style = aStyle;
	command = aCommand;
	latched = FALSE;
	helpID = 0;
	SetWantsClicks(TRUE);
}


void CKeyPane::SetHelp(short anIndex, short aResID)
{
	helpResIndex = anIndex;
	helpID = aResID;
}

short CKeyPane::GetHelpResID()
{
	if (helpID == kKeyHelpID && gTI59 != NULL && gTI59->SecondPending()) return kKey2ndHelpID;
	return helpID != 0 ? helpID : CPane::GetHelpResID();
}


/* A latching key (the printer's TRACE) stays down until pressed again. */
void CKeyPane::SetLatched(Boolean aLatched)
{
	Rect r;

	latched = aLatched;
	Prepare();
	KeyRect(&r);
	DrawKey(&r, latched);
}


void CKeyPane::KeyRect(Rect *r)
{
	FrameToQDR(&frame, r);
	r->top += 14;
}


void CKeyPane::Draw(Rect *area)
{
	Rect	r, k;
	short	w, x;

	FrameToQDR(&frame, &r);
	RGBForeColor(&kPanel);
	PaintRect(&r);
	if (second[0] > 0) {
		TextFont(kGeneva);
		TextSize(9);
		TextFace(normal);
		TextMode(srcOr);
		RGBForeColor(&kLabel);
		if (PEqual(second, "xbar")) {					/* x with a bar over it		*/
			w = CharWidth('x');
			x = (short) ((r.left + r.right - w) / 2);
			MoveTo(x, (short) (r.top + 11));
			DrawChar('x');
			MoveTo(x, (short) (r.top + 3));
			LineTo((short) (x + w - 1), (short) (r.top + 3));
		}
		else {
			w = StringWidth(second);
			MoveTo((short) ((r.left + r.right - w) / 2), (short) (r.top + 11));
			DrawString(second);
		}
	}
	KeyRect(&k);
	DrawKey(&k, latched);
}


void CKeyPane::DrawKey(Rect *r, Boolean pressed)
{
	RGBColor	face;
	Rect		k = *r;
	short		w, i, cx, cy, size;
	Str255		base, sup;

	RGBForeColor(&kPanel);
	PaintRect(&k);
	InsetRect(&k, 2, 1);
	LightenFor(style, pressed, &face);
	if (pressed && latched && style == kKeySecond) face = kSecondOn;	/* 2nd waits for its key: lit	*/
	RGBForeColor(&kShadow);								/* the key's shadow			*/
	OffsetRect(&k, 1, 2);
	PaintRoundRect(&k, 6, 6);
	OffsetRect(&k, -1, -2);
	RGBForeColor(&face);
	PaintRoundRect(&k, 6, 6);
	if (!pressed) {
		RGBForeColor(style == kKeyDark ? &kHiLite : &kWhiteC);
		MoveTo((short) (k.left + 3), (short) (k.top + 1));
		LineTo((short) (k.right - 4), (short) (k.top + 1));
	}

	TextFont(kGeneva);
	TextFace(bold);
	TextMode(srcOr);
	size = (legend[0] == 1) ? 12 : 10;
	TextSize(size);
	RGBForeColor(style == kKeyDark ? &kDarkTx : style == kKeySecond ? &kSecondT : &kBlackC);
	cx = (short) ((k.left + k.right) / 2);
	cy = (short) (k.bottom - 8);

	if (PEqual(legend, "*")) {							/* the multiplication cross	*/
		PenSize(2, 2);
		MoveTo((short) (cx - 4), (short) (cy - 9)); LineTo((short) (cx + 3), (short) (cy - 2));
		MoveTo((short) (cx + 3), (short) (cy - 9)); LineTo((short) (cx - 4), (short) (cy - 2));
		PenSize(1, 1);
	}
	else if (PEqual(legend, "-")) {						/* a long minus				*/
		PenSize(2, 2);
		MoveTo((short) (cx - 5), (short) (cy - 6)); LineTo((short) (cx + 4), (short) (cy - 6));
		PenSize(1, 1);
	}
	else {
		for (i = 1; i <= legend[0] && legend[i] != '^'; i++) ;
		if (i <= legend[0]) {							/* "x^2", "y^x": superscript	*/
			BlockMove(legend + 1, base + 1, (long) (i - 1)); base[0] = (unsigned char) (i - 1);
			BlockMove(legend + i + 1, sup + 1, (long) (legend[0] - i)); sup[0] = (unsigned char) (legend[0] - i);
			TextSize(12);
			w = StringWidth(base);
			TextSize(9);
			w += StringWidth(sup);
			TextSize(12);
			MoveTo((short) (cx - w / 2), cy);
			DrawString(base);
			TextSize(9);
			Move(0, -5);
			DrawString(sup);
		}
		else {
			w = StringWidth(legend);
			MoveTo((short) (cx - w / 2), cy);
			DrawString(legend);
		}
	}

	TextFace(normal);
	RGBForeColor(&kBlackC);
	RGBBackColor(&kWhiteC);
}


void CKeyPane::DoClick(Point hitPt, short modifierKeys, long when)
{
	Rect	r;
	Point	pt;
	Boolean	in, was;

	Prepare();
	KeyRect(&r);
	in = PtInRect(hitPt, &r);
	if (!in) return;								/* a click on the 2nd label		*/
	DrawKey(&r, TRUE);
	while (StillDown()) {
		GetMouse(&pt);
		was = in;
		in = PtInRect(pt, &r);
		if (in != was) DrawKey(&r, in);
	}
	DrawKey(&r, latched);
	if (in && itsSupervisor != NULL)
		itsSupervisor->DoCommand(command);
}



/* The printer's paper: a CEditText whose balloon (item 4 of 'hrct' kPrinterHelpID) TCL places at the pane,
   wherever the paper is scrolled to. */
class CPaperText : public CEditText
{
public:
	CPaperText(CView *anEnclosure, CBureaucrat *aSupervisor, short aWidth, short aHeight, short aHEncl,
			   short aVEncl, SizingOption aHSizing, SizingOption aVSizing, short aLineWidth, Boolean aScrollHoriz)
		: CEditText(anEnclosure, aSupervisor, aWidth, aHeight, aHEncl, aVEncl, aHSizing, aVSizing,
					aLineWidth, aScrollHoriz) { helpResIndex = 4; }
	virtual short GetHelpResID(void) { return kPrinterHelpID; }
};

TCL_DEFINE_CLASS_M1(CMain, x_CMain);

CMain *gTI59 = NULL;		/* the calculator, for CApp::OpenDocument: a card opened in the Finder goes into it */

/**** C O N S T R U C T I O N / D E S T R U C T I O N   M E T H O D S ****/


void CMain::ICMain()

{
	Handle	h;

	display = NULL;
	body = NULL;
	history = NULL;
	histScroll = NULL;
	prnWindow = NULL;
	helpWindow = NULL;
	helpText = NULL;
	prnPlaced = FALSE;
	chore = NULL;
	fullSpeed = FALSE;
	printer = TRUE;
	listStopOn = TRUE;
	lastTick = TickCount();
	budget = 0;
	tapHead = tapCount = 0;
	tapKey = tapPhase = 0;
	tapCycles = 0;
	blankFeeds = 0;
	cardState = 0;
	cardHelp = -1;
	secondKey = NULL;
	traceKey = NULL;
	trace = FALSE;
	prnBtnCycles = 0;
	romOK = FALSE;
	moduleOK = FALSE;
	pendCard = FALSE;
	secondPending = FALSE;
	gTI59 = this;

	romHelpShown = FALSE;

	core = new TI59Core;
	h = GetResource('TROM', 128);						/* the private build carries the ROM	*/
	if (core != NULL && h != NULL && GetHandleSize(h) == (long) kTI59BlobBytes) {
		HLock(h);
		core->LoadBlob((const u8 *) *h);
		HUnlock(h);
		romOK = TRUE;
	}
	if (h != NULL) ReleaseResource(h);
	if (core != NULL && !romOK) romOK = LoadRomFolder();	/* the public one reads Calc-U-59's dumps	*/
	if (romOK) {
		core->PowerOn();
		core->SetPrinterConnected((u8) printer);
	}

	moduleOK = FALSE;									/* the solid-state module	*/
	h = GetResource('TLIB', 128);
	if (romOK && h != NULL && GetHandleSize(h) == 5000L) {
		HLock(h);
		core->LoadLibrary((const u8 *) *h, 5000UL);
		HUnlock(h);
		moduleOK = TRUE;
	}
	if (h != NULL) ReleaseResource(h);
	if (romOK && !moduleOK) moduleOK = LoadModuleFolder();
	if (!romOK) HMSetMenuResID(130, 131);				/* Mars Lander grey because the ROM is missing, not the module */

	Ix_CMain();
}


/******************************************************************************
 MakeNewWindow {OVERRIDE}

	Everything is enclosed by the WINDOW, not by itsMainPane: the main pane
	keeps Visual Architect's original 306 x 237 view and clips below y 237.
	The printer window is made here and placed beside the calculator once
	the calculator's window has found its place (first RunCpu).

 ******************************************************************************/

void CMain::MakeNewWindow()

{
	short	i;
	Rect	b;

	x_CMain::MakeNewWindow();
	{															/* VA's view limits the window	*/
		Rect sr;												/* to 512 x 342; ChangeSize	*/
		SetRect(&sr, 40, 40, 1024, 768);						/* obeys that limit			*/
		itsWindow->SetSizeRect(&sr);
	}
	itsWindow->ChangeSize(kWinWidth, kWinHeight);
	itsWindow->SetTitle("\pMac-59");						/* VA's view calls it Rechner	*/

	body = new CBodyPane(itsWindow, this, kWinWidth, kWinHeight);	/* first: drawn below the rest */
	display = new CLedDisplay(itsWindow, this, 272, 38, 12, 26);

	for (i = 0; i < kKeyCount; i++) {
		CKeyPane *k = new CKeyPane(itsWindow, this, 48, 40,
					 (short) (14 + 56 * kKeys[i].col), (short) (118 + 44 * kKeys[i].row),
					 kKeys[i].legend, kKeys[i].second, kKeys[i].style,
					 cmdKeyBase + (kKeys[i].row + 1) * 10 + kKeys[i].col + 1);
		k->SetHelp((short) (i + 1), kKeyHelpID);		/* the key's balloon, without or with 2nd */
		if (kKeys[i].style == kKeySecond) secondKey = k;
	}

	SetRect(&b, 400, 60, 400 + kPrnWidth, 60 + kWinHeight);
	prnWindow = new CWindow(&b, FALSE, documentProc, FALSE, FALSE, this);	/* with a size box */
	prnWindow->SetTitle("\pPC-100C");
	{														/* wider and longer paper; the	*/
		Rect sr;											/* keys need 208 pixels			*/
		SetRect(&sr, kPrnWidth, 200, 400, 740);
		prnWindow->SetSizeRect(&sr);
	}
	CKeyPane *prnPrintKey = new CKeyPane(prnWindow, this, 69, 40, 0, 0, "PRINT", "", kKeyDark, cmdPrnPrint);	/* the printer's keys */
	CKeyPane *prnAdvKey = new CKeyPane(prnWindow, this, 69, 40, 69, 0, "ADV", "", kKeyDark, cmdPrnAdv);
	traceKey = new CKeyPane(prnWindow, this, 70, 40, 138, 0, "TRACE", "", kKeyDark, cmdPrnTrace);
	prnPrintKey->SetHelp(1, kPrinterHelpID);			/* balloons placed by TCL at the panes: the paper's */
	prnAdvKey->SetHelp(2, kPrinterHelpID);				/* scrolling moves this window's origin, which put  */
	traceKey->SetHelp(3, kPrinterHelpID);				/* the static 'hrct' rectangles off the keys        */
	histScroll = new CScrollPane(prnWindow, this, kPrnWidth, kWinHeight - 40, 0, 40,
								 sizELASTIC, sizELASTIC, FALSE, TRUE, TRUE);	/* follows the window */
	history = new CPaperText(histScroll, this, kPrnWidth - 18, kWinHeight - 42, 0, 0,
							sizELASTIC, sizELASTIC, -1, FALSE);
	history->SetFontNumber(kMonaco);
	history->SetFontSize(9);
	history->Specify(kNotEditable, kSelectable, kNotStylable);	/* select + Copy, plain TEXT */
	histScroll->InstallPanorama(history);

	itsGopher = this;		/* keys and Copy go to the calculator, not to a text pane */

	ShowInfo();
}


void CMain::MakeWindowName(Str255 newName)
{
	itsWindow->GetTitle(newName);
}


void CMain::MakeNewContents()
{
	chore = new CCpuChore;
	chore->itsMain = this;
	gApplication->AssignIdleChore(chore);
}

void CMain::ContentsToWindow()	{}
void CMain::WindowToContents()	{}

/* CDocument declares OpenFile pure virtual; Visual Architect generates it only
   for documents that use a file ("Use file" is off for Rechner). */
void CMain::OpenFile(SFReply *macSFReply)	{}


/* The chore and the printer window are not the document's to free; the core is. */
Boolean CMain::Close(Boolean quitting)
{
	if (chore != NULL) {
		gApplication->CancelIdleChore(chore);
		delete chore;
		chore = NULL;
	}
	if (prnWindow != NULL) {
		delete prnWindow;
		prnWindow = NULL;
	}
	if (helpWindow != NULL) {
		delete helpWindow;
		helpWindow = NULL;
	}
	if (core != NULL) {
		delete core;
		core = NULL;
	}
	if (gTI59 == this) gTI59 = NULL;
	return x_CMain::Close(quitting);
}


/******************************************************************************
 DoCommand / UpdateMenus / DoKeyDown

 ******************************************************************************/

void CMain::DoCommand(long theCommand)

{
	if (theCommand > cmdKeyBase && theCommand < cmdKeyBase + 100)
		QueueKey((short) (theCommand - cmdKeyBase));
	else if (theCommand == cmdCopy)
		CopyResult();
	else if (theCommand == cmdPaste)
		PasteKeys();
	else if (theCommand == cmdPrnPrint || theCommand == cmdPrnAdv) {
		if (!romOK || !printer) { SysBeep(1); return; }
		if (theCommand == cmdPrnPrint) core->PressPrinterPrint(1);
		else core->PressPrinterAdv(1);
		prnBtnCycles = kHoldCycles;
	}
	else if (theCommand == cmdPrnTrace) {
		if (!romOK || !printer) { SysBeep(1); return; }
		trace = (Boolean) !trace;
		core->SetPrinterTrace((u8) trace);
		traceKey->SetLatched(trace);
	}
	else if (theCommand == cmdMarsLander) {
		if (!moduleOK) { SysBeep(1); return; }
		QueueKey(21); QueueKey(31); QueueKey(82); QueueKey(72);	/* 2nd Pgm 1 4 */
		body->SetCue(0, "Burn");
		body->SetCue(1, "Fuel");
		body->SetCue(2, "Vel.Alt");
		body->SetCue(3, "");
		body->SetCue(4, "Start");
	}
	else if (theCommand == cmdLanderHelp)
		ShowHelp(300, "Mars Lander \xD0 Anleitung", "Mars Lander Anleitung");
	else if (theCommand == cmdMoonHelp)
		ShowHelp(301, "Mondlandung \xD0 Anleitung", "Mondlandung Anleitung");
	else if (theCommand == cmdCardHelp)
		ShowCardHelp(cardHelp);
	else if (theCommand == cmdCourseHelp)
		ShowHelp(302, "Mac-59 \xD0 Programmierkurs", "Programmierkurs Anleitung");
	else if (theCommand == cmdTearOff)
		DoCmdClearHistory();
	else if (theCommand == cmdSavePaper)
		SavePaper();
	else if (theCommand == cmdPrinterOn)
		SetPrinter((Boolean) !printer);
	else if (theCommand == cmdListStop)
		listStopOn = (Boolean) !listStopOn;
	else if (theCommand == cmdReadCard)
		ReadCard();
	else if (theCommand == cmdBlankCard)
		InsertBlankCard();
	else if (theCommand == cmdSelectAll && history != NULL) {
		if (prnWindow != NULL && printer) prnWindow->Select();
		history->SelectAll(TRUE);
	}
	else
		x_CMain::DoCommand(theCommand);
}


void CMain::UpdateMenus()

{
	x_CMain::UpdateMenus();
	gBartender->EnableCmd(cmdCopy);
	gBartender->EnableCmd(cmdPaste);
	gBartender->EnableCmd(cmdSelectAll);
	gBartender->EnableCmd(cmdReadCard);
	gBartender->EnableCmd(cmdBlankCard);
	gBartender->EnableCmd(cmdTearOff);
	gBartender->EnableCmd(cmdSavePaper);
	gBartender->EnableCmd(cmdPrinterOn);
	if (moduleOK) gBartender->EnableCmd(cmdMarsLander);
	gBartender->EnableCmd(cmdLanderHelp);
	gBartender->EnableCmd(cmdMoonHelp);
	gBartender->EnableCmd(cmdCourseHelp);
	if (cardHelp >= 0) gBartender->EnableCmd(cmdCardHelp);
	gBartender->EnableCmd(cmdListStop);
	gBartender->CheckMarkCmd(cmdPrinterOn, printer);
	gBartender->CheckMarkCmd(cmdListStop, listStopOn);
}


void CMain::DoKeyDown(char theChar, Byte keyCode, EventRecord *macEvent)

{
	short	code = KeyForChar(theChar);

	if (code != 0) QueueKey(code);
	else x_CMain::DoKeyDown(theChar, keyCode, macEvent);
}


/******************************************************************************
 The CPU

 ******************************************************************************/

void CCpuChore::Perform(long *maxSleep)
{
	if (itsMain != NULL) itsMain->RunCpu(maxSleep);
}


void CMain::QueueKey(short code)
{
	if (!romOK || tapCount >= kTapQueue) { SysBeep(1); return; }
	tapQueue[(tapHead + tapCount) % kTapQueue] = code;
	tapCount++;
	Boolean second = (Boolean) (code == 21 && !secondPending);	/* 2nd toggles, as in the ROM: 2nd 2nd x2 = x2	*/
	if (second != secondPending) {				/* TCL shows a balloon only when the pointer enters a */
		secondPending = second;					/* view: forget the last one, so the key under the	*/
		CView::cLastHelpView = NULL;			/* pointer shows its other text at once			*/
		if (HMGetBalloons()) HMRemoveBalloon();
		if (secondKey != NULL) secondKey->SetLatched(second);	/* lit until the next key (operator) */
	}
}


/* One key at a time: held kHoldCycles, then released until the keyboard
   loop runs again (at least kGapCycles, at most kMaxGapCycles). A key that
   finds the TI busy (a running program, a listing on the printer) is held
   kBusyHoldCycles: the ROM looks at the keyboard only between printed lines,
   and R/S held 0.1 s did not stop 2nd List. */
static unsigned long gTapHold = kHoldCycles;
static ListStop gListStop;		/* zeroed: no listing seen yet */

void CMain::StepTap(unsigned long w)
{
	u16 pc;

	if (prnBtnCycles > 0) {							/* the printer's PRINT / ADV key	*/
		prnBtnCycles -= (long) w;
		if (prnBtnCycles <= 0) { core->PressPrinterPrint(0); core->PressPrinterAdv(0); }
	}
	if (tapKey == 0) {
		if (gListStop.stopWanted) {					/* the listing passed the program's end		*/
			gListStop.stopWanted = 0;
			pc = core->PC();
			if (pc < kTI59ScanLoLo || pc > kTI59ScanLoHi) {	/* only into a busy TI: idle, R/S would run */
				tapKey = 91;
				gTapHold = kBusyHoldCycles;
				core->PressMatrix(tapKey);
				tapPhase = 1;
				tapCycles = 0;
			}
			return;
		}
		if (tapCount == 0) return;
		tapKey = tapQueue[tapHead];
		tapHead = (short) ((tapHead + 1) % kTapQueue);
		tapCount--;
		pc = core->PC();
		gTapHold = (pc >= kTI59ScanLoLo && pc <= kTI59ScanLoHi) ? kHoldCycles : kBusyHoldCycles;
		core->PressMatrix(tapKey);
		tapPhase = 1;
		tapCycles = 0;
		return;
	}
	tapCycles += w;
	if (tapPhase == 1) {
		if (tapCycles >= gTapHold) {
			core->ReleaseMatrix(tapKey);
			tapPhase = 2;
			tapCycles = 0;
		}
	}
	else if (tapCycles >= kGapCycles) {
		pc = core->PC();
		if ((pc >= kTI59ScanLoLo && pc <= kTI59ScanLoHi) || tapCycles >= kMaxGapCycles)
			tapKey = 0;
	}
}


void CMain::RunCpu(long *maxSleep)
{
	unsigned long	now = TickCount(), until, w;
	long			dt;
	short			i;

	if (!romOK || core == NULL) {
		if (!romHelpShown && body != NULL) {			/* no ROM: say where it comes from, once	*/
			romHelpShown = TRUE;
			ShowHelp(303, "Mac-59 \xD0 ROM fehlt", "ROM Anleitung");
		}
		return;
	}
	if (!prnPlaced) PlacePrinter();

	if (fullSpeed) {
		until = now + 3;
		do {
			for (i = 0; i < 500; i++) StepTap(core->Step() & 0xFF);
		} while (TickCount() < until);
		*maxSleep = 0;
	}
	else {
		dt = (long) (now - lastTick);
		if (dt > 10) dt = 10;					/* after a pause: no catching up	*/
		budget += dt * kTickCycles;
		while (budget > 0) {
			w = core->Step() & 0xFF;
			budget -= (long) w;
			StepTap(w);
		}
		if (*maxSleep > 1) *maxSleep = 1;
	}
	lastTick = now;
	UpdateDisplay();
	DrainPrinter();
	if (cardState != 0 && !core->CardPresent()) FinishCard();	/* the ROM ended the pass */
	if (pendCard && TickCount() - pendTick > 30 && tapKey == 0
		&& core->PC() >= kTI59ScanLoLo && core->PC() <= kTI59ScanLoHi) {	/* a card from the Finder, into an idle TI */
		pendCard = FALSE;
		ReadCardFile(pendName, pendVRef);
	}
}


/* What the multiplex drove since the last call: a cell that was not driven is dark. */
void CMain::UpdateDisplay()
{
	TI59Display		d;
	unsigned char	seg[12], dp[12];
	short			i;

	core->TakeDisplay(&d);
	if (d.pollTicks == 0) return;
	for (i = 0; i < 12; i++) {
		seg[i] = 0;
		if (d.litTicks[i] != 0)
			switch (d.ctrl[i]) {
				case 0: case 1: case 8: case 9: seg[i] = kDigitSeg[(d.digits[i] & 0x0F) % 10]; break;
				case 5: seg[i] = (unsigned char) (d.digits[i] == 0 ? kSegMinus : kSegDegree); break;
				case 6: seg[i] = kSegMinus; break;
			}
		dp[i] = (unsigned char) (d.dpTicks[i] != 0);
	}
	if (d.cTicks != 0) seg[11] = kSegC;			/* the C annunciator				*/
	display->SetCells(seg, dp);
}


/******************************************************************************
 The printer

	Its window sits right of the calculator and is shown while the printer
	is connected. Paper advance comes in half lines: two blank half lines
	make one blank line on the strip.

 ******************************************************************************/

void CMain::PlacePrinter()
{
	WindowPtr	w = itsWindow->GetMacPort();
	Rect		c;

	/* TCL builds the window off screen and moves it into place later: wait for that.
	   The content region is in global coordinates whatever origin a pane has set. */
	if (!((WindowPeek) w)->visible) return;
	c = (**((WindowPeek) w)->contRgn).rgnBBox;
	if (c.left < 0 || c.top < 20 || c.left > 1024) return;
	prnWindow->Move((short) (c.left + kWinWidth + 8), c.top);
	if (printer) {
		prnWindow->Show();
		itsWindow->Select();
	}
	prnPlaced = TRUE;
}


void CMain::DrainPrinter()
{
	TI59PrintLine	pl;
	char			line[24];
	short			i;
	Boolean			blank;

	while (core->TakePrintLine(&pl)) {
		if (listStopOn && !ListStopLine(&gListStop, &pl, core)) continue;
		blank = TRUE;
		for (i = 0; i < 20; i++) {
			line[i] = kPrnChars[pl.codes[i] & 0x3F];
			if (pl.codes[i] != 0) blank = FALSE;
		}
		line[20] = '\0';
		for (i = 19; i >= 0 && line[i] == ' '; i--) line[i] = '\0';	/* no trailing blanks to copy */
		if (blank) {
			if (++blankFeeds % 2 == 0) AddHistoryLine("");
		}
		else {
			blankFeeds = 0;
			AddHistoryLine(line);
		}
	}
}


void CMain::AddHistoryLine(const char *line)

{
	static char cr[2] = { '\r', '\0' };
	long	len;
	Handle	h;

	h = history->GetTextHandle();
	len = (h != NULL) ? GetHandleSize(h) : 0;
	history->SetSelection(len, len, FALSE);
	history->InsertTextPtr((Ptr) line, (long) CLen(line), TRUE);
	history->InsertTextPtr(cr, 1L, TRUE);
	history->ScrollToSelection();
}


void CMain::DoCmdClearHistory()

{
	static char empty[1] = { '\0' };

	history->SetTextPtr(empty, 0L);
	history->Refresh();
}


/******************************************************************************
 Status line, Copy, Settings

 ******************************************************************************/

void CMain::ShowInfo()
{
	Str255	s;

	if (!romOK) CToPStr("ROM fehlt", s);
	else if (fullSpeed) CToPStr("Volle Geschwindigkeit", s);
	else CToPStr("455 kHz", s);
	if (body != NULL) body->SetInfo(s);
}


/* The display - or, with the printer window in front, the paper - as TEXT only:
   no 'styl' for the emulator's scrap bridge. */
void CMain::CopyResult()

{
	char	buf[48];
	long	a, b, len;
	Handle	h;

	if (prnWindow != NULL && FrontWindow() == (WindowPtr) prnWindow->GetMacPort()) {
		h = history->GetTextHandle();						/* the paper: the selection,	*/
		len = (h != NULL) ? GetHandleSize(h) : 0;			/* or all of it				*/
		history->GetSelection(&a, &b);
		if (a >= b) { a = 0; b = len; }
		if (h == NULL || b <= a) { SysBeep(1); return; }
		ZeroScrap();
		HLock(h);
		PutScrap(b - a, 'TEXT', *h + a);
		HUnlock(h);
		return;
	}
	display->GetText(buf);
	ZeroScrap();
	PutScrap((long) CLen(buf), 'TEXT', (Ptr) buf);
}


/******************************************************************************
 PasteKeys

	Paste types the clipboard's TEXT on the calculator. A number goes in the
	TI-59's way - mantissa, +/- if negative, EE, exponent, +/- - so
	"-3,5E-2" works; everything else is one key per character (KeyForChar),
	so "2+3*4=" works too. A '-' is a sign only where an operand starts.

 ******************************************************************************/

static Boolean IsDigit(char c) { return (Boolean) (c >= '0' && c <= '9'); }

void CMain::PasteKeys()
{
	Handle	h = NewHandle(0);
	long	off, len, i;
	char	*s, c;
	Boolean	operandNext = TRUE, neg, eneg;
	short	code;

	if (h == NULL) return;
	len = GetScrap(h, 'TEXT', &off);
	if (len > 200) len = 200;
	if (len <= 0) { DisposHandle(h); SysBeep(1); return; }
	HLock(h);
	s = *h;
	i = 0;
	while (i < len) {
		c = s[i];
		if (operandNext && (IsDigit(c) || c == '.' || c == ',' ||
			((c == '-' || c == '+') && i + 1 < len && (IsDigit(s[i + 1]) || s[i + 1] == '.' || s[i + 1] == ',')))) {
			neg = (Boolean) (c == '-');
			if (c == '-' || c == '+') i++;
			while (i < len && (IsDigit(s[i]) || s[i] == '.' || s[i] == ','))
				QueueKey(KeyForChar(s[i++]));
			if (neg) QueueKey(94);							/* +/-						*/
			if (i < len && (s[i] == 'e' || s[i] == 'E') && i + 1 < len &&
				(IsDigit(s[i + 1]) || ((s[i + 1] == '-' || s[i + 1] == '+') && i + 2 < len && IsDigit(s[i + 2])))) {
				i++;
				QueueKey(52);								/* EE						*/
				eneg = (Boolean) (s[i] == '-');
				if (s[i] == '-' || s[i] == '+') i++;
				while (i < len && IsDigit(s[i])) QueueKey(KeyForChar(s[i++]));
				if (eneg) QueueKey(94);
			}
			operandNext = FALSE;
			continue;
		}
		if (c == '\r' || c == '\n') { i++; continue; }		/* a line end is not '='		*/
		code = KeyForChar(c);
		if (code != 0) {
			QueueKey(code);
			operandNext = (Boolean) (c != ')');
		}
		i++;												/* spaces, line ends: skipped */
	}
	HUnlock(h);
	DisposHandle(h);
}


/* 'DLOG'/'DITL' 201: 1 OK, 2 Abbrechen, 3 full speed, 4 printer connected. */
void CMain::DoCmdSettings()

{
	DialogPtr	dlg;
	short		item, type;
	Handle		hFast, hPrn;
	Rect		box;

	dlg = GetNewDialog(kSettingsDLOG, NULL, (WindowPtr) -1L);
	if (dlg == NULL) { SysBeep(5); return; }

	GetDItem(dlg, 3, &type, &hFast, &box);
	GetDItem(dlg, 4, &type, &hPrn, &box);
	SetCtlValue((ControlHandle) hFast, fullSpeed ? 1 : 0);
	SetCtlValue((ControlHandle) hPrn, printer ? 1 : 0);

	do {
		ModalDialog(NULL, &item);
		if (item == 3 || item == 4) {
			Handle hh = (item == 3) ? hFast : hPrn;
			SetCtlValue((ControlHandle) hh, 1 - GetCtlValue((ControlHandle) hh));
		}
	} while (item != 1 && item != 2);

	if (item == 1) {
		fullSpeed = (Boolean) (GetCtlValue((ControlHandle) hFast) != 0);
		if ((GetCtlValue((ControlHandle) hPrn) != 0) != (printer != 0))
			SetPrinter((Boolean) !printer);
	}
	DisposDialog(dlg);
	lastTick = TickCount();
	budget = 0;
	ShowInfo();
}


/******************************************************************************
 The ROM from a folder

	Without 'TROM' 128 (the public build) the ROM comes from Calc-U-59's text
	dumps in a folder "ROM" next to the application (RomText.h reads them as
	Calc-U-59's own loader does): TMC0582.txt, TMC0583.txt, TMC0571B.txt and
	the two -CONST-K files; the Leisure Library from TMC0547.txt, there or in
	ROM:solid-state: as Calc-U-59 keeps it. The default directory is the
	application's folder, as for the manuals.

 ******************************************************************************/

static Ptr ReadRomFile(const char *name, long *len)		/* a whole file, NULL if absent	*/
{
	Str255	path;
	short	ref;
	Ptr		p;

	CToPStr(name, path);
	if (FSOpen(path, 0, &ref) != noErr) return NULL;
	GetEOF(ref, len);
	p = (*len > 0 && *len < 200000L) ? NewPtr(*len) : NULL;
	if (p != NULL && FSRead(ref, len, p) != noErr) { DisposPtr(p); p = NULL; }
	FSClose(ref);
	return p;
}

Boolean CMain::LoadRomFolder()
{
	static const char *kFiles[5] = { ":ROM:TMC0582.txt", ":ROM:TMC0583.txt", ":ROM:TMC0571B.txt",
									 ":ROM:TMC0582-CONST-K.txt", ":ROM:TMC0583-CONST-K.txt" };
	Ptr		text[5];
	long	len[5];
	u8		*blob = (u8 *) NewPtr(kTI59BlobBytes);
	u16		*words = (u16 *) NewPtr(kTI59RomWords * 2L);
	Boolean	ok = FALSE;
	short	i;

	for (i = 0; i < 5; i++) text[i] = ReadRomFile(kFiles[i], &len[i]);
	if (blob != NULL && words != NULL && RomTextBlob((const char * const *) text, len, blob, words)) {
		core->LoadBlob(blob);
		ok = TRUE;
	}
	for (i = 0; i < 5; i++) if (text[i] != NULL) DisposPtr(text[i]);
	if (blob != NULL) DisposPtr((Ptr) blob);
	if (words != NULL) DisposPtr((Ptr) words);
	return ok;
}

Boolean CMain::LoadModuleFolder()
{
	long	len;
	Ptr		text = ReadRomFile(":ROM:TMC0547.txt", &len);
	u8		*img;
	Boolean	ok = FALSE;

	if (text == NULL) text = ReadRomFile(":ROM:solid-state:TMC0547.txt", &len);
	if (text == NULL) return FALSE;
	img = (u8 *) NewPtr(kRomTextModuleBytes);
	if (img != NULL && RomTextModule(text, len, img) > 0) {
		core->LoadLibrary(img, (u32) kRomTextModuleBytes);
		ok = TRUE;
	}
	DisposPtr(text);
	if (img != NULL) DisposPtr((Ptr) img);
	return ok;
}


/******************************************************************************
 Magnetic cards

	A card is a file: one bank of 246 bytes, written as Calc-U-59's binary card
	("Calc-U-59-CRD" + the bank; Calc-U-59 reads it, its pickers list names
	ending in .u59), read in that layout, as 246 / 984 raw bytes, or as
	Calc-U-59's text card ("Calc-U-59 Card 1.0", CardText.cp).

	Reading: choose a file; it goes through the reader as an inserted card.
	The ROM reads it if the calculator is idle and the card's partition is
	the current one (otherwise the card runs through unread and the display
	blinks); afterwards the display shows the bank number.
	Writing: n 2nd Write, then a blank card; when the ROM has written it, the
	bank is saved under a name you choose.

 ******************************************************************************/

static const char kCrdMagic[] = "Calc-U-59-CRD";			/* 13 bytes, no terminator used */
#define kCrdMagicLen	13

void CMain::CardMessage(const char *msg)
{
	Str255 s;
	CToPStr(msg, s);
	if (body != NULL) body->SetInfo(s);
	SysBeep(1);
}


/* Karte einlesen... and File > Open list cards only (TRUE hides a file; folders are always listed):
   the TI-59's own (creator 'TI59', type 'TICD'), Calc-U-59's by name (.u59, .bin) and raw banks by
   size (246 bytes, 13 + 246 with Calc-U-59's header, 984 for all four banks). */
static Boolean EndsWith(ConstStr255Param name, const char *ext)
{
	short	i, n = 0;
	char	c;

	while (ext[n] != 0) n++;
	if (name[0] < n) return FALSE;
	for (i = 0; i < n; i++) {
		c = (char) name[name[0] - n + 1 + i];
		if (c >= 'A' && c <= 'Z') c = (char) (c - 'A' + 'a');
		if (c != ext[i]) return FALSE;
	}
	return TRUE;
}

pascal Boolean CardFileFilter(ParmBlkPtr pb)
{
	FInfo	*fi = &pb->fileParam.ioFlFndrInfo;
	long	len = pb->fileParam.ioFlLgLen;

	if (fi->fdType == 'APPL') return TRUE;						/* Mac-59 itself has the cards' creator */
	if (fi->fdCreator == 'TI59' || fi->fdType == 'TICD') return FALSE;
	if (EndsWith(pb->fileParam.ioNamePtr, ".u59") || EndsWith(pb->fileParam.ioNamePtr, ".bin")) return FALSE;
	if (len == 246 || len == kCrdMagicLen + 246 || len == 984) return FALSE;
	return TRUE;
}


void CMain::ReadCard()
{
	SFReply		r;
	SFTypeList	types;
	Point		where;

	if (!romOK) { SysBeep(1); return; }
	where.h = 80; where.v = 80;
	SFGetFile(where, "\p", NewFileFilterProc(CardFileFilter), -1, types, NULL, &r);
	lastTick = TickCount();
	budget = 0;
	if (r.good) ReadCardFile(r.fName, r.vRefNum);
}


/* A card opened in the Finder (CApp::OpenDocument): read when the TI idles, as a card is only read then;
   after a launch by that very card the calculator is still powering up. */
void CMain::QueueCard(ConstStr255Param name, short vRefNum)
{
	BlockMove(name, pendName, (long) name[0] + 1);
	pendVRef = vRefNum;
	pendCard = TRUE;
	pendTick = TickCount();
}


void CMain::ReadCardFile(ConstStr255Param fName, short vRefNum)
{
	short		ref, skip = 0;
	long		len, n;
	Ptr			buf;

	if (!romOK) { SysBeep(1); return; }
	if (cardState != 0) { core->CardEject(); cardState = 0; }	/* one card at a time */
	if (FSOpen(fName, vRefNum, &ref) != noErr) { CardMessage("Karte: nicht lesbar"); return; }
	GetEOF(ref, &len);
	if (len <= 0 || len > 32000) { FSClose(ref); CardMessage("Karte: falsche Groesse"); return; }
	buf = NewPtr(len);
	if (buf == NULL) { FSClose(ref); SysBeep(5); return; }
	n = len;
	FSRead(ref, &n, buf);
	FSClose(ref);
	if (n == kCrdMagicLen + 246 && memcmp(buf, kCrdMagic, kCrdMagicLen) == 0) { skip = kCrdMagicLen; n = 246; }
	else if (n == 246 || n == 984) skip = 0;
	else if (CardTextIs(buf, n)) {						/* Calc-U-59's text card		*/
		u8 bank[246];
		if (!CardTextParse(buf, n, bank)) { DisposPtr(buf); CardMessage("Textkarte fehlerhaft"); return; }
		BlockMove(bank, buf, 246L);
		skip = 0;
		n = 246;
	}
	else {
		CardMessage("Keine Kartendatei");
		DisposPtr(buf);
		return;
	}
	core->InsertCard((const u8 *) buf + skip, (u32) n);
	DisposPtr(buf);
	cardState = 1;
	body->SetCardName((StringPtr) fName);
	cardHelp = CardHelpIndex(fName);
	if (cardHelp >= 0) ShowCardHelp(cardHelp);
	ShowInfo();
}


void CMain::InsertBlankCard()
{
	if (!romOK) { SysBeep(1); return; }
	if (cardState != 0) { core->CardEject(); cardState = 0; }
	core->InsertCard(NULL, 0);
	cardState = 2;
	body->SetCardName("\pleere Karte");
	cardHelp = -1;
	ShowInfo();
}


/* The ROM ended the pass (CRD.OFF ejects the card): a written bank is saved. */
void CMain::FinishCard()
{
	const u8	*bank = core->CardEject();
	short		st = cardState, ref, bankNo;
	OSErr		err;
	SFReply		r;
	Point		where;
	Str255		name;
	long		n;

	cardState = 0;
	if (st == 1) return;							/* read: the display says which bank	*/
	if (bank == NULL) {
		body->SetCardName("\p");
		CardMessage("Karte leer: erst n 2nd Write");
		return;
	}
	bankNo = (short) ((bank[2] & 0x0F) / 3 + 1);
	CToPStr("Mac-59 Bank 1.u59", name);					/* Calc-U-59 lists .u59 / .bin	*/
	name[12] = (unsigned char) ('0' + bankNo);
	where.h = 80; where.v = 80;
	SFPutFile(where, "\pKarte sichern als:", name, NULL, &r);
	lastTick = TickCount();
	budget = 0;
	if (!r.good) { body->SetCardName("\p"); return; }
	err = Create(r.fName, r.vRefNum, 'TI59', 'TICD');		/* creator 'TI59': a double-click opens the card in the TI-59 */
	if (err != noErr && err != dupFNErr) { CardMessage("Karte: nicht gesichert"); return; }
	if (FSOpen(r.fName, r.vRefNum, &ref) != noErr) { CardMessage("Karte: nicht gesichert"); return; }
	SetEOF(ref, 0L);
	n = kCrdMagicLen;
	FSWrite(ref, &n, (Ptr) kCrdMagic);
	n = 246;
	FSWrite(ref, &n, (Ptr) bank);
	FSClose(ref);
	FlushVol(NULL, r.vRefNum);
	body->SetCardName(r.fName);
}


/******************************************************************************
 The Drucker menu

	Angeschlossen connects or disconnects the PC-100C (its window shows and
	hides with it; TRACE springs out, as on the hardware). Papier abreissen
	tears the paper off: what was printed is gone. Papier sichern saves it as
	a SimpleText document.

 ******************************************************************************/

void CMain::SetPrinter(Boolean on)
{
	printer = on;
	if (core != NULL) core->SetPrinterConnected((u8) printer);	/* also releases TRACE */
	trace = FALSE;
	if (traceKey != NULL) traceKey->SetLatched(FALSE);
	if (prnWindow != NULL && prnPlaced) {
		if (printer) { prnWindow->Show(); itsWindow->Select(); }
		else prnWindow->Hide();
	}
	ShowInfo();
}


void CMain::SavePaper()
{
	SFReply	r;
	Point	where;
	Handle	h = history->GetTextHandle();
	long	len, n;
	short	ref;
	OSErr	err;

	len = (h != NULL) ? GetHandleSize(h) : 0;
	if (len == 0) { CardMessage("Das Papier ist leer"); return; }
	where.h = 80; where.v = 80;
	SFPutFile(where, "\pPapierstreifen sichern als:", "\pMac-59 Papier", NULL, &r);
	lastTick = TickCount();
	budget = 0;
	if (!r.good) return;
	err = Create(r.fName, r.vRefNum, 'ttxt', 'TEXT');			/* a SimpleText document		*/
	if (err != noErr && err != dupFNErr) { CardMessage("Papier: nicht gesichert"); return; }
	if (FSOpen(r.fName, r.vRefNum, &ref) != noErr) { CardMessage("Papier: nicht gesichert"); return; }
	SetEOF(ref, 0L);
	n = len;
	HLock(h);
	FSWrite(ref, &n, *h);
	HUnlock(h);
	FSClose(ref);
	FlushVol(NULL, r.vRefNum);
}


/* The manual's text: styled TextEdit (headings bold), but Copy puts plain TEXT on the
   clipboard only - a 'styl' scrap is what crashed Basilisk II on copying. */
class CHelpText : public CStyleText
{
public:
	CHelpText() {}		/* then IStyleText: TCL's CStyleText(...) constructor builds its TE in the
						   CEditText constructor, where MakeMacTE is still CEditText's (TENew, one
						   style); after construction it is CStyleText's (TEStylNew) */
	virtual void DoCommand(long theCommand);
	virtual void Scroll(long hDelta, long vDelta, Boolean redraw);
};

/* Lines of different heights: shifting the pixels and redrawing the exposed strip
   (CPanorama::Scroll) tore the text; redraw it all instead. */
void CHelpText::Scroll(long hDelta, long vDelta, Boolean redraw)
{
	CStyleText::Scroll(hDelta, vDelta, FALSE);
	if (redraw) Refresh();
}

void CHelpText::DoCommand(long theCommand)
{
	long	a, b;
	Handle	h;

	if (theCommand != cmdCopy) { CStyleText::DoCommand(theCommand); return; }
	GetSelection(&a, &b);
	h = GetTextHandle();
	if (h == NULL || b <= a) { SysBeep(1); return; }
	ZeroScrap();
	HLock(h);
	PutScrap(b - a, 'TEXT', *h + a);
	HUnlock(h);
}


/* A line of capitals (and blanks) is a heading. */
static Boolean IsHeading(const char *p, long n)
{
	long i;

	if (n < 3) return FALSE;
	for (i = 0; i < n; i++)
		if (!((p[i] >= 'A' && p[i] <= 'Z') || p[i] == ' ')) return FALSE;
	return TRUE;
}


/* Headings bold 12 (the first line 14): every line of capitals in text p[0..len). */
static void BoldHeadings(CHelpText *ht, const char *p, long len)
{
	TextStyle	st;
	long		a, e;

	ht->SetSelection(0, len, FALSE);
	st.tsFont = kGeneva; st.tsSize = 10; st.tsFace = 0;
	ht->SetStyle(doFont + doSize + doFace, &st, FALSE);
	for (a = 0; a < len; a = e + 1) {
		for (e = a; e < len && p[e] != '\r'; e++) ;
		if (IsHeading(p + a, e - a)) {
			ht->SetSelection(a, e, FALSE);
			st.tsFace = bold;
			st.tsSize = (short) (a == 0 ? 14 : 12);
			ht->SetStyle(doFace + doSize, &st, FALSE);
		}
	}
}


/* A manual in a window of its own, beside the printer. The text is the SimpleText document
   fileName next to the application, so it can be edited there - with its own styles
   ('styl' 128) if it has more than one (formatted there), else headings made bold here; without the document it is
   'TEXT' textID. Its close box only hides the window (CloseWind), the menu shows it again; the window
   is shared by the manuals and loads another one's text when that is asked for. */
static short gHelpID = 0;

void CMain::ShowHelp(short textID, const char *title, const char *fileName)
{
	Rect			b, sr;
	Handle			h = NULL;
	StScrpHandle	sty = NULL;
	Str255			t;
	CHelpText		*ht;
	CScrollPane		*sp;
	long			len;
	short			ref, rf, cur;

	if (helpWindow == NULL) {
		SetRect(&b, 530, 60, 1010, 500);
		helpWindow = new CWindow(&b, FALSE, documentProc, FALSE, TRUE, this);
		SetRect(&sr, 200, 120, 1000, 740);
		helpWindow->SetSizeRect(&sr);
		sp = new CScrollPane(helpWindow, this, 480, 440, 0, 0, sizELASTIC, sizELASTIC, FALSE, TRUE, TRUE);
		ht = new CHelpText;
		ht->IStyleText(sp, this, 462, 438, 0, 0, sizELASTIC, sizELASTIC, -1);
		ht->Specify(kNotEditable, kSelectable, kStylable);
		sp->InstallPanorama(ht);
		sp->SetSteps(10, 13);		/* TCL's CEditText::GetSteps would take the TE's lineHeight,
									   which a styled TE reports as -1: scrolling tore the text */
		helpText = ht;
	}
	if (gHelpID != textID) {
		gHelpID = textID;
		ht = (CHelpText *) helpText;
		ht->SetTextPtr("", 0);
		CToPStr(fileName, t);
		if (FSOpen(t, 0, &ref) == noErr) {				/* the SimpleText document	*/
			GetEOF(ref, &len);
			h = NewHandle(len);
			if (h != NULL) { HLock(h); FSRead(ref, &len, *h); HUnlock(h); }
			FSClose(ref);
			cur = CurResFile();
			rf = OpenResFile(t);
			if (rf != -1) {
				sty = (StScrpHandle) Get1Resource('styl', 128);
				if (sty != NULL && (**sty).scrpNStyles < 2) sty = NULL;	/* one style: plain text */
				if (sty != NULL) DetachResource((Handle) sty);
				CloseResFile(rf);
			}
			UseResFile(cur);
		}
		else if ((h = GetResource('TEXT', textID)) != NULL) DetachResource(h);
		if (h != NULL) {
			len = GetHandleSize(h);
			HLock(h);
			if (sty != NULL) ht->InsertWithStyles(*h, len, sty);
			else { ht->SetTextPtr(*h, len); BoldHeadings(ht, *h, len); }
			ht->SetSelection(0, 0, FALSE);
			ht->ScrollToSelection();	/* the other manual may have been scrolled */
			HUnlock(h);
			DisposHandle(h);
			if (sty != NULL) DisposHandle((Handle) sty);
		}
	}
	CToPStr(title, t);
	helpWindow->SetTitle(t);
	helpWindow->Show();
	helpWindow->Select();
}


/* Help for a card: a course card opens its lesson in the Programmierkurs, a Mondlandung card the
   Mondlandung manual - by the card's name, when it is read and with Mac-59 > Hilfe zur Karte. The
   manual is scrolled to the end first, then to the lesson's title: TCL scrolls no further than it
   must, so the title comes to stand at the top of the window. */
struct CardHelpRow { const char *prefix; short textID; const char *title; const char *file; const char *mark; };
static const CardHelpRow kCardHelp[] = {
	{ "Kurs Temperatur", 302, "Mac-59 \xD0 Programmierkurs", "Programmierkurs Anleitung", "\r2.3 " },
	{ "Kurs Betrag",     302, "Mac-59 \xD0 Programmierkurs", "Programmierkurs Anleitung", "\r3.2 " },
	{ "Kurs Summe",      302, "Mac-59 \xD0 Programmierkurs", "Programmierkurs Anleitung", "\r3.3 " },
	{ "Kurs Fakultaet",  302, "Mac-59 \xD0 Programmierkurs", "Programmierkurs Anleitung", "\r4.1 " },
	{ "Kurs Indirekt",   302, "Mac-59 \xD0 Programmierkurs", "Programmierkurs Anleitung", "\r4.2 " },
	{ "Mondlandung",     301, "Mondlandung \xD0 Anleitung",  "Mondlandung Anleitung",     "\rSTART\r" }
};
enum { kCardHelpRows = sizeof kCardHelp / sizeof kCardHelp[0] };

short CMain::CardHelpIndex(ConstStr255Param name)
{
	short	i, k;

	for (i = 0; i < kCardHelpRows; i++) {
		const char *p = kCardHelp[i].prefix;
		for (k = 0; p[k] != 0 && k < name[0] && name[k + 1] == p[k]; k++) ;
		if (p[k] == 0) return i;
	}
	return -1;
}

void CMain::ShowCardHelp(short row)
{
	Handle	h;
	long	len, pos, end, k;
	const char *mark;

	if (row < 0 || row >= kCardHelpRows) return;
	ShowHelp(kCardHelp[row].textID, kCardHelp[row].title, kCardHelp[row].file);
	if (helpText == NULL) return;
	h = helpText->GetTextHandle();
	len = helpText->GetLength();
	if (h == NULL) return;
	mark = kCardHelp[row].mark;
	HLock(h);
	for (pos = 0; pos < len; pos++) {
		for (k = 0; mark[k] != 0 && pos + k < len && (*h)[pos + k] == mark[k]; k++) ;
		if (mark[k] == 0) break;
	}
	if (pos < len) {
		pos++;													/* past the line end before the title	*/
		for (end = pos; end < len && (*h)[end] != '\r'; end++) ;
		HUnlock(h);
		helpText->SetSelection(len, len, FALSE);
		helpText->ScrollToSelection();
		helpText->SetSelection(pos, end, TRUE);
		helpText->ScrollToSelection();
	}
	else HUnlock(h);
}


/* The manual's close box hides it; every other window goes the usual way. */
void CMain::CloseWind(CWindow *theWindow)
{
	if (theWindow == helpWindow && helpWindow != NULL) helpWindow->Hide();
	else x_CMain::CloseWind(theWindow);
}
